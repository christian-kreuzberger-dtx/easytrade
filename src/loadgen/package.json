{
  "name": "easytrade-load-generator",
  "version": "0.1.0",
  "description": "Load generator for easyTrade based on loadgen-core",
  "main": "./build/src/main.js",
  "scripts": {
    "build": "rm -rf ./build & tsc",
    "start": "node .",
    "dev": "node -r ts-node/register --env-file=.env ./src/main.ts",
    "format": "prettier -w .",
    "lint": "eslint ./src"
  },
  "dependencies": {
    "@demoability/loadgen-core": "^1.3.33",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint__js": "^9.14.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
